{
  "name": "great-marketrealm/great-marketrealm-expansions",
  "description": "Expansion rules, data, and content packs for The Great MarketRealm.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "GreatMarketrealmExpansions\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "GreatMarketrealmExpansions\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --display-warnings"
  }
}
